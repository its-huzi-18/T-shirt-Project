# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Current applet URL
APP_URL="MY_APP_URL"

# HA Clothing Admin Authentication Credentials
# The real credentials will be entered by you in the environment configuration
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_THIS_PASSWORD
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=CHANGE_THIS_PASSWORD

# Firebase Client Configuration (Vite environment variables)
# Copy these to your private .env file and replace with your project's credentials.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="YOUR_FIREBASE_FIRESTORE_DATABASE_ID"
VITE_FIREBASE_OAUTH_CLIENT_ID="YOUR_FIREBASE_OAUTH_CLIENT_ID"
