rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'huzaifawahab2005@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ================= PRODUCT RULES =================
    function isValidProduct(p) {
      return p.name is string && p.name.size() > 0 && p.name.size() <= 200 &&
             p.price is number && p.price >= 0 &&
             p.category is string && p.category.size() <= 100 &&
             p.stock is number && p.stock >= 0;
    }

    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create: if isValidId(productId) && isAdmin() && isValidProduct(incoming());
      allow update: if isValidId(productId) && (
        isAdmin() || 
        // Allow stock decrement on order placement
        (incoming().diff(existing()).affectedKeys().hasOnly(['stock']) && incoming().stock is number && incoming().stock >= 0)
      );
      allow delete: if isValidId(productId) && isAdmin();
    }

    // ================= CATEGORY RULES =================
    function isValidCategory(c) {
      return c.name is string && c.name.size() > 0 && c.name.size() <= 100 &&
             c.slug is string && c.slug.size() > 0 && c.slug.size() <= 120;
    }

    match /categories/{categoryId} {
      allow read: if isValidId(categoryId);
      allow create, update, delete: if isValidId(categoryId) && isAdmin() && (request.method == 'delete' || isValidCategory(incoming()));
    }

    // ================= ORDER RULES =================
    function isValidOrder(o) {
      return o.orderNumber is string && o.orderNumber.size() > 0 && o.orderNumber.size() <= 64 &&
             o.customerName is string && o.customerName.size() > 0 && o.customerName.size() <= 150 &&
             o.customerEmail is string && o.customerEmail.size() > 0 && o.customerEmail.size() <= 150 &&
             o.customerPhone is string && o.customerPhone.size() > 0 && o.customerPhone.size() <= 50 &&
             o.total is number && o.total >= 0 &&
             o.items is list && o.items.size() > 0 && o.items.size() <= 50 &&
             o.orderStatus in ['Pending', 'Confirmed', 'Processing', 'Printed', 'Shipped', 'Delivered', 'Cancelled'];
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isAdmin() || (isSignedIn() && existing().customerId == request.auth.uid) || true);
      allow list: if isAdmin() || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isValidId(orderId) && isValidOrder(incoming());
      allow update: if isValidId(orderId) && isAdmin();
      allow delete: if isValidId(orderId) && isAdmin();
    }

    // ================= STORE SETTINGS RULES =================
    match /settings/{settingId} {
      allow read: if isValidId(settingId);
      allow create, update, delete: if isValidId(settingId) && isAdmin();
    }

    // ================= NOTIFICATION RULES =================
    function isValidNotification(n) {
      return n.type is string && n.type.size() <= 50 &&
             n.title is string && n.title.size() <= 150 &&
             n.message is string && n.message.size() <= 500;
    }

    match /notifications/{notificationId} {
      // Customers/guests create notifications when placing orders
      allow create: if isValidId(notificationId) && isValidNotification(incoming());
      allow read, update, delete: if isValidId(notificationId) && isAdmin();
    }

    // ================= REVIEWS RULES =================
    function isValidReview(r) {
      return r.productId is string && r.productId.size() <= 100 &&
             r.customerName is string && r.customerName.size() <= 100 &&
             r.rating is number && r.rating >= 1 && r.rating <= 5 &&
             r.comment is string && r.comment.size() <= 1000;
    }

    match /reviews/{reviewId} {
      allow read: if isValidId(reviewId);
      allow create: if isValidId(reviewId) && isValidReview(incoming());
      allow update, delete: if isValidId(reviewId) && isAdmin();
    }

    // ================= USER PROFILES RULES =================
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow delete: if isValidId(userId) && isAdmin();
    }

    // ================= ADMIN PRIVILEGES RULES =================
    match /admins/{adminId} {
      allow read: if isValidId(adminId) && isAdmin();
      allow write: if isValidId(adminId) && isAdmin();
    }
  }
}
