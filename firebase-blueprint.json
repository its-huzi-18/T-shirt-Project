{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Custom printed T-shirt product in the catalog",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 250 },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "sku": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 100 },
        "images": { "type": "array" },
        "thumbnail": { "type": "string", "maxLength": 1000 },
        "sizes": { "type": "array" },
        "colors": { "type": "array" },
        "stock": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "draft", "archived"] },
        "isFeatured": { "type": "boolean" },
        "isNewArrival": { "type": "boolean" },
        "isBestSeller": { "type": "boolean" },
        "tags": { "type": "array" },
        "rating": { "type": "number" },
        "reviewsCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "slug", "price", "category", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product collection category",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "productCount": { "type": "number" }
      },
      "required": ["name", "slug"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer purchase order",
      "type": "object",
      "properties": {
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 150 },
        "customerEmail": { "type": "string", "maxLength": 150 },
        "customerPhone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "city": { "type": "string", "maxLength": 100 },
        "area": { "type": "string", "maxLength": 100 },
        "postalCode": { "type": "string", "maxLength": 30 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "paymentStatus": { "type": "string", "maxLength": 50 },
        "orderStatus": { "type": "string", "enum": ["Pending", "Confirmed", "Processing", "Printed", "Shipped", "Delivered", "Cancelled"] },
        "customerNotes": { "type": "string", "maxLength": 1000 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["orderNumber", "customerName", "customerEmail", "customerPhone", "address", "city", "items", "total", "orderStatus"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Global website and brand customization settings",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "heroHeading": { "type": "string", "maxLength": 200 },
        "heroDescription": { "type": "string", "maxLength": 1000 },
        "heroImage": { "type": "string", "maxLength": 1000 },
        "promoBanner": { "type": "string", "maxLength": 300 },
        "showPromoBanner": { "type": "boolean" },
        "contactEmail": { "type": "string", "maxLength": 100 },
        "contactPhone": { "type": "string", "maxLength": 50 },
        "address": { "type": "string", "maxLength": 300 },
        "currency": { "type": "string", "maxLength": 10 },
        "currencySymbol": { "type": "string", "maxLength": 5 },
        "shippingFee": { "type": "number" },
        "freeShippingThreshold": { "type": "number" }
      }
    },
    "Notification": {
      "title": "Notification",
      "description": "Store admin event notification",
      "type": "object",
      "properties": {
        "type": { "type": "string", "maxLength": 50 },
        "title": { "type": "string", "maxLength": 150 },
        "message": { "type": "string", "maxLength": 500 },
        "orderId": { "type": "string", "maxLength": 100 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "title", "message"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review",
      "type": "object",
      "properties": {
        "productId": { "type": "string", "maxLength": 100 },
        "customerName": { "type": "string", "maxLength": 100 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerName", "rating", "comment"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Customer profile and preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "displayName": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "savedAddresses": { "type": "array" }
      },
      "required": ["email"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin authorization marker",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of custom printed T-shirts"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Customer purchase orders"
    },
    "/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Global store and brand customization configuration"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Admin activity notifications"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Customer product reviews"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and customer accounts"
    },
    "/admins/{adminId}": {
      "schema": "AdminRecord",
      "description": "List of authorized administrator user IDs"
    }
  }
}
